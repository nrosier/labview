# The declaration the probe could not confirm — which is not the same as one it contradicts.
# Local accounts are the mechanism no scan can observe, which is why a file like this exists
# at all, and why the probe's silence about it says nothing. See the compose file beside this
# one for what the address actually served and why that settles neither way.
services:
  portal:
    description: Staff portal with its own user accounts.
    auth:
      - mechanism: app-local-accounts
        detail: Accounts live in the portal's own database; there is no SSO in front.
