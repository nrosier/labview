# Deliberately OUTSIDE fixtures/edge (the apps root used by the edge-case smoke
# pass). fixtures/edge/dbstack references this via a relative env_file path; the
# scanner must refuse to read it. If LEAKED_FROM_OUTSIDE_ROOT ever shows up in
# the parsed env, env_file containment has regressed.
LEAKED_FROM_OUTSIDE_ROOT=this-must-never-be-read
