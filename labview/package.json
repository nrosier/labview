{
  "name": "labview",
  "version": "0.1.0",
  "private": true,
  "description": "Scans homelab docker compose stacks (DockFlare / Traefik / Authentik) and serves a structured overview website.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:web && npm run build:server",
    "dev:web": "node scripts/build-web.mjs --watch",
    "dev": "npm run build:web && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "scan": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "dockerode": "^4.0.2",
    "fastify": "^5.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^26.1.2",
    "cytoscape": "^3.30.2",
    "esbuild": "^0.24.0",
    "mermaid": "^11.4.0",
    "preact": "^10.25.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
